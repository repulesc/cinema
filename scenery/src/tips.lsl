// *** TAKE 12 SCENERY (free), generated by tools/build_scenery.py from hud/src: do not edit by hand ***
// ============================================================================
//  Take 12  -  tips.lsl  (v5.8)  - the text above the button: status, sharing, tips
//  The one owner of the text above the HUD. It shows, top to bottom:
//   - the sharing block from sync (TEXT 7380): "● LIVE · 2 watching / Ana · Ben", "👁 Pano", an invitation;
//   - the status line while a camera runs: the mode and who is in charge ("◇ Scenery · auto", "♡ Friends ·
//     your view", "◇ Scenery · started while you were idle", "... · paused · Esc to carry on"; 7.0: no Photo);
//     nothing with your own camera, and only the 👁 block while you watch someone;
//   - a tip, for 6 s, when something just happened (each retires after 3 showings; after all, or 24 in all, Tips
//     turns itself off; Help > Tips brings them back, from zero).
//  The button, while a camera runs: a tiny clap (the sheet's clapped frame, a quarter of a second) when it starts,
//  then every 8-12 s; perfectly still with your own camera and in a pause. Same frame maths as ui's frame().
//  Short notices of other scripts (lens, Frame, sync: "Your view is kept", "Half length", "Ana joined") take the whole
//  text for their few seconds: whatever is on screen that this script did not write is left alone, and when its
//  script clears it, the status comes back within a second.
// ============================================================================

string VERSION = "7.1.2";
string PASS    = "cinema-1.0-build1";

integer LENS        = 7319;   // lens -> friends  "<distance>|...": distance 0 = automatic, else your own view
integer START       = 7301;   // core -> cameras "<mode>|<fov>": your lens at the start
integer FOVMSG      = 7318;   // core -> cameras: your lens changed (radians)
integer UI_STATE    = 7320;   // core -> all  "<state>|<mode>|<nextCutUnix>|<why>"  (why: "idle" = idle start)
integer CFG_CHANGED = 7330;
integer MSG_VER     = 7360;
integer STATUS      = 7370;
integer TEXT        = 7380;   // sync -> here  "<live/view/inv or empty>|<the sharing block>"
integer STILL       = 7381;   // frame -> here "<framing>|<recommended mm>|<your mm>": the lens guide

integer MAXN = 3;             // showings per tip
integer ALL  = 24;            // ... and in all, then Tips is off
float   HOLD = 6.0;           // s on screen
float   LATE = 1.5;           // s after the event
float   WAIT = 10.0;          // s a tip waits for a free moment, then it is dropped (not counted)
float   GAP  = 20.0;          // s between two tips

// 0 hello  1 scenery  2 me  3 us  4 friends  5 me (Framing)  6 connected  7 paused  8 back  9 more  10 sitting: Adjust  11 idle start
// 12 your lens  13 freehand
// Under a status line only the second line shows, so it must make sense on its own.
list TIPS = [
    "Take 12 Scenery\nTap: menu · Double-tap: scenery",
    "Scenery\ndouble-tap: next view · any key: your camera",
    "Me\nwalk around, it follows you · tap: menu",
    "Us\nit cuts to whoever speaks · double-tap: next",
    "Friends\nframe it yourself, then Esc: it keeps your view",
    "Me\nwalk: it follows · Adjust: the keys trim the shot",
    "Connected\nwhoever films leads · hold: the Connect panel",
    "Paused\nyou moved the camera, so it waits for you",
    "Your camera is back\ndouble-tap: scenery again",
    "Tap while it rolls\ntap: next, stop",
    "Sitting\nsitting: W/S tilt · A/D around · PgUp/PgDn height",
    "Idle start\nstay idle ",
    "Your lens\nCtrl+0 zoom in · Ctrl+8 out · Ctrl+9 back",
    "Freehand\nframe it, hold still: it holds · Adjust: trim it"];
list MODES = ["scenery", "personal", "social", "friends", "frame", "free"];   // tips 1 to 5, and 13
list NAMES = ["Scenery", "Me", "Us", "Friends", "Me", "Freehand"];      // 7.0: Me is Framing › Me (frame)
list MARKS = ["◇", "○", "◎", "♡", "○", "✥"];
// your lens (35 mm equivalent) and the range each camera suggests: Scenery wide, people 24-85 (Still has its own guide;
// Freehand: every lens is yours)
list LO = [0, 35, 24, 35, 0, 0];
list HI = [28, 50, 50, 85, 999, 999];

key     gOwner;
integer gOn;                 // Tips on
integer gStat;               // the status line on
string  gN;                  // showings per tip, one digit each
string  gSt;                 // the last state, mode and why from core
string  gMode;
string  gWhy;
integer gLed;                // Only friends: your own view (lens)
string  gStill;              // Still: the framing, the lens for it, yours (from frame)
string  gKind;               // the sharing block from sync: live / view / inv / ""
string  gSync;
string  gTip;                // the tip on screen ("" = none)
string  gText;               // the text this script composed last
string  gLast;               // ... and as it reads back from the prim (cut short past 254 bytes)
// 6.7.1: every script answers ui's version check (MSG_VER "?"); one that stays silent is missing or stopped, and
// without it a menu can do nothing at all (Share did, when share.lsl was not in the HUD). Said once, in chat.
string  NEED = "core scenery";
list    gHeard;              // who answered
float   gVerT;               // ... since the check (0: none running)
integer gWant = -1;          // the tip waiting for a free moment
float   gWantT;
float   gShowT;
float   gLastT = -100.0;
float   gRollT;              // rolling since (0: not rolling)
integer gMore;               // the "Hold > More" tip was offered this run
integer gSat;                // ... and the sitting one
integer gAdj;                // the keys adjust the shot (core)
integer gLensTip;            // ... and the lens one
float   gFov = 1.047198;     // your lens (field of view, radians)
integer gLook = 1;           // the button: its look (frames 2n open, 2n+1 clapped) and face, as ui draws it
integer gFace = ALL_SIDES;
float   gClapT;              // filming: the next tiny clap (0 = the button is still)
float   gClapEnd;            // ... the clapped frame shows until then

string cfg(string k)
{
    return llLinksetDataReadProtected("cin." + k, PASS);
}

load()
{
    gOn = (cfg("tips") != "0");
    gStat = (cfg("status") != "0");
    gLook = (integer)cfg("look");
    gFace = ALL_SIDES;
    if (cfg("face") != "") gFace = (integer)cfg("face");
    gN = cfg("tipn");
    while (llStringLength(gN) < llGetListLength(TIPS)) gN += "0";
}

integer seen(integer i)
{
    return (integer)llGetSubString(gN, i, i);
}

want(integer i)
{
    if (!gOn || seen(i) >= MAXN) return;
    gWant = i;
    gWantT = llGetTime();
}

string cur()
{
    return llList2String(llGetPrimitiveParams([PRIM_TEXT]), 0);
}

integer free()
{
    string c = cur();
    return (c == "" || c == gLast);
}

// Still's lens guide: "85 mm ✓" within 15 %, else what to press (only you can zoom: a script can read it, not set it)
string guide()
{
    list L = llParseStringKeepNulls(gStill, ["|"], []);
    integer want = (integer)llList2String(L, 1);
    integer now = (integer)llList2String(L, 2);
    string s = llList2String(L, 0) + " · " + (string)want + " mm";
    if (llAbs(now - want) * 100 <= 15 * want) return s + " ✓";
    if (now < want) return s + " · now " + (string)now + " · Ctrl+0";
    return s + " · now " + (string)now + " · Ctrl+8";
}

// your lens against the camera's range and the key for it: " · 21 mm · try 24 · Ctrl+0", or " · 35 mm ✓"
string lensTxt(integer m)
{
    integer n = llRound(12.0 / llTan(gFov * 0.5));
    integer lo = llList2Integer(LO, m);
    integer hi = llList2Integer(HI, m);
    string s = " · " + (string)n + " mm";
    if (n < lo) return s + " · try " + (string)lo + " · Ctrl+0";
    if (n > hi) return s + " · try " + (string)hi + " · Ctrl+8";
    return s + " ✓";
}

// the status line: the mode and who is in charge; nothing with your own camera
string line()
{
    integer m = llListFindList(MODES, [gMode]);
    if (m < 0 || (gSt != "rolling" && gSt != "peek")) return "";
    if (!gStat && !(gMode == "frame" && gSt == "rolling")) return "";    // Still's lens guide shows even then
    string s = llList2String(NAMES, m);
    string k = llList2String(MARKS, m);
    string w = "auto";
    if (gMode == "frame" && gStill != "") w = guide();
    else if (gMode == "frame") w = "held";
    else if (gMode == "friends" && gLed) w = "your view";
    else if (gMode == "free") w = "held";
    else if (gMode == "scenery" && gWhy == "idle") w = "started while you were idle";
    if (gSt == "peek" && gMode == "free") w = "framing · hold still" + lensTxt(m);   // your lens while you frame
    else if (gSt == "peek") w = "paused · Esc to carry on";
    else if (gMode != "frame") w += lensTxt(m);
    if (gAdj) w += " · ✛ Adjust";
    return k + " " + s + " · " + w;
}

// sharing block, status line, tip: written only when it changed, and never over another script's notice
draw()
{
    string c = cur();
    if (c != "" && c != gLast) return;
    list L = [];
    if (gSync != "") L += [gSync];
    if (gKind != "view" && line() != "") L += [line()];
    if (gTip != "") L += [gTip];
    string t = llDumpList2String(L, "\n");
    if (t == gText && c == gLast) return;
    gText = t;
    llSetText(t, <1.0, 1.0, 1.0>, 0.85);
    gLast = cur();                                          // as Second Life keeps it (over 254 bytes it is cut short)
}

string idleText()
{
    integer s = (integer)cfg("afk_sec");
    string t = (string)s + " s";
    if (s % 60 == 0) t = (string)(s / 60) + " min";
    return t + ": the scenery starts by itself";
}

show(integer i)
{
    gTip = llList2String(TIPS, i);
    if (i == 11) gTip += idleText();
    if (gKind != "view" && line() != "") gTip = llList2String(llParseString2List(gTip, ["\n"], []), 1);
    gShowT = llGetTime();
    gLastT = gShowT;
    gWant = -1;
    draw();
    string c = (string)(seen(i) + 1);
    gN = llInsertString(llDeleteSubString(gN, i, i), i, c);
    llLinksetDataWriteProtected("cin.tipn", gN, PASS);
    integer k;
    integer all;
    integer done = TRUE;
    for (k = 0; k < llStringLength(gN); k++)
    {
        all += seen(k);
        if (seen(k) < MAXN) done = FALSE;
    }
    if (done || all >= ALL)
    {
        gOn = FALSE;
        llLinksetDataWriteProtected("cin.tips", "0", PASS);
        llMessageLinked(LINK_SET, CFG_CHANGED, "tips", "");
        llOwnerSay("[Take 12] Tips are off now · Help › Tips brings them back.");
    }
}

// the state changed: a tip for what just happened
onState(string st, string mode)
{
    integer rolling = (st == "rolling");
    integer idle = (st != "rolling" && st != "peek");
    integer was = (gSt == "rolling" || gSt == "peek");
    gTip = "";                                              // a shown tip is about what was
    gShowT = 0.0;
    if (gWant != 0 || !idle) gWant = -1;                    // the hello waits through the start-up states
    if (rolling && (!was || mode != gMode))                 // a new run (not the end of a pause)
    {
        gRollT = llGetTime();
        gMore = FALSE;
        gSat = FALSE;
        gLensTip = FALSE;
        integer m = llListFindList(MODES, [mode]);
        if (m >= 0) want(m + 1 + 7 * (m == 5));             // Freehand: tip 13
    }
    else if (st == "peek" && mode != "free") want(7);       // Freehand: framing is the point, not a pause
    else if (idle && was)
    {
        gRollT = 0.0;
        if (seen(8) < MAXN) want(8);
        else if (st == "armed" && cfg("afk_on") == "1") want(11);
    }
    gSt = st;
    gMode = mode;
}

// the button: open (shut = FALSE) or clapped, on the sprite sheet (4 x 2 frames, row 0 on top)
clap(integer shut)
{
    integer k = 2 * gLook + shut;
    float oy = 0.25;
    if (k > 3) oy = -0.25;
    llScaleTexture(0.25, 0.5, gFace);
    llOffsetTexture(((float)(k % 4) + 0.5) / 4.0 - 0.5, oy, gFace);
}

tick()
{
    draw();
    if (gClapEnd > 0.0) llSetTimerEvent(0.25);
    else if (gWant >= 0 || gShowT > 0.0 || gClapT > 0.0) llSetTimerEvent(0.5);
    else if (gLast != "" || gRollT > 0.0 || gSync != "" || gVerT > 0.0) llSetTimerEvent(1.0);    // back within a second after a notice
    else llSetTimerEvent(0.0);
}

default
{
    state_entry()
    {
        gOwner = llGetOwner();
        load();
        llMessageLinked(LINK_SET, MSG_VER, VERSION, "tips");
        if (llGetAttached()) want(0);
        tick();
    }

    on_rez(integer p)
    {
        llResetScript();
    }

    changed(integer c)
    {
        if (c & CHANGED_OWNER) llResetScript();
    }

    link_message(integer sender, integer num, string str, key id)
    {
        if (num == UI_STATE)
        {
            list L = llParseStringKeepNulls(str, ["|"], []);
            string st = llList2String(L, 0);
            string mode = llList2String(L, 1);
            if (st != gSt || (st == "rolling" && mode != gMode)) onState(st, mode);
            gWhy = llList2String(L, 3);
            gAdj = (integer)llList2String(L, 4);            // 7.1.1: Adjust shows on the status line while it is on
            if (st != "rolling")
            {
                gClapT = 0.0;                               // still: your own camera, a pause
                if (gClapEnd > 0.0) clap(FALSE);
                gClapEnd = 0.0;
            }
            else if (gClapT == 0.0) gClapT = llGetTime();   // the camera rolls: a clap now
            if (mode != "friends") gLed = FALSE;
        }
        else if (num == STILL) gStill = str;
        else if (num == START || num == FOVMSG)
        {
            float f = (float)llList2String(llParseStringKeepNulls(str, ["|"], []), num == START);
            if (f > 0.05) gFov = f;
        }
        else if (num == LENS) gLed = ((float)llList2String(llParseStringKeepNulls(str, ["|"], []), 0) > 0.0);
        else if (num == TEXT)
        {
            integer i = llSubStringIndex(str, "|");
            string was = gKind;
            gKind = "";
            if (i > 0) gKind = llGetSubString(str, 0, i - 1);
            if (was == "" && (gKind == "live" || gKind == "view")) want(6);     // connected: what it means
            gSync = llDeleteSubString(str, 0, i);                  // not llGetSubString(str, i + 1, -1): on "|" that is "|"
        }
        else if (num == CFG_CHANGED && (str == "tips" || str == "status" || str == "skin" || str == "look" || str == "face" || str == "all")) load();
        else if (num == MSG_VER && str == "?")
        {
            llMessageLinked(LINK_SET, MSG_VER, VERSION, "tips");
            gHeard = [];
            gVerT = llGetTime();
        }
        else if (num == MSG_VER) gHeard += [(string)id];
        else if (num == STATUS && str == "?")
            llOwnerSay("[Take 12/tips] v" + VERSION + " status line " + llList2String(["off", "on"], gStat) + ", tips "
                + llList2String(["off", "on"], gOn) + ", seen " + gN + ", free mem " + (string)llGetFreeMemory());
        else return;
        tick();
    }

    timer()
    {
        float now = llGetTime();
        if (gVerT > 0.0 && now - gVerT > 4.0)
        {
            gVerT = 0.0;
            list N = llParseString2List(NEED, [" "], []);
            list m = [];
            integer i;
            for (i = 0; i < llGetListLength(N); i++)
                if (llListFindList(gHeard, [llList2String(N, i)]) < 0) m += [llList2String(N, i)];
            if (m != []) llOwnerSay("[Take 12] Missing or stopped: " + llDumpList2String(m, ", ") + ". Add them from the same release "
                + "(or Build > Scripts > Set Scripts to Running in Selection): without them some menus do nothing.");
        }
        if (gShowT > 0.0 && now - gShowT >= HOLD)
        {
            gTip = "";
            gShowT = 0.0;
        }
        if (gClapEnd > 0.0 && now >= gClapEnd)
        {
            gClapEnd = 0.0;
            clap(FALSE);
        }
        else if (gClapT > 0.0 && now >= gClapT)
        {
            clap(TRUE);                                     // the tiny clap, a quarter of a second
            gClapEnd = now + 0.25;
            gClapT = now + 8.0 + llFrand(4.0);
        }
        if (gRollT > 0.0 && gSt == "rolling" && gWant < 0 && gShowT == 0.0)
        {
            integer m = llListFindList(MODES, [gMode]);
            if (!gLensTip && m >= 0 && m < 4 && now - gLastT >= GAP && llGetSubString(lensTxt(m), -1, -1) != "✓")
            {
                gLensTip = TRUE;                            // your lens is outside what this camera suggests
                want(12);
            }
            else if (!gSat && m >= 1 && m <= 4 && (llGetAgentInfo(gOwner) & AGENT_SITTING))   // seated in a people camera: Fit
            {
                gSat = TRUE;
                want(10);
            }
            else if (!gMore && now - gRollT >= 90.0)
            {
                gMore = TRUE;
                want(9);
            }
        }
        if (gWant >= 0)
        {
            if (!gOn || now - gWantT > WAIT) gWant = -1;    // no free moment: dropped, not counted
            else if (now - gWantT >= LATE && now - gLastT >= GAP && free()) show(gWant);
        }
        tick();
    }
}
