// ============================================================================
//  Take 12  -  strip.lsl  (8.0.2)  - the strip (the Monitor look)
//  A cinema camera's on-screen display: one thin strip of small-caps words on the top (or bottom) edge. The shots at
//  its left (TRACKING · PORTRAIT · FIXED · SCENIC, the running one bright and underlined), the running shot's options at
//  its right (the current ones the same), on a black band from the screen's edge, and in the middle the frame key (▭ 2.39 / 4:5 / FULL: this shot's frames) and Connect (linked rings:
//  the count, SHARING, THEIR FILM) either side of the [12]. Double-tap the [12] (ui) opens and closes it with a
//  0.2 s fade; closed, every strip part shrinks away to the root (an invisible prim would still catch clicks). A touch
//  on a word becomes a command (core, the shot, bars, sync). The [12] itself, its ring and dot, the notes' part, the
//  eye line and the textures are screen.lsl's (8.0.2: the two were one script, too big for Second Life's 64 KB).
//  HUD space is 1.0 tall and as wide as the window (llGetCameraAspect), +Y left, +Z up, +X into the screen; parts are
//  placed from the root, which screen keeps at the strip's middle. The words stay in a centred 16:9 area, 180 px in
//  from its corners (less on a narrow window, so nothing ever overlaps). Places and sizes: cin.place, cin.size.
//  Auto (8.3.0): the Orbit at the left end (the shutter's mirror). Lit, Auto directs (tracking.lsl): the shot words and
//  options go, and the shot it chose stays in faint letters; a tap on either hands you the camera (manual). Dim, the
//  four shots are back; a tap gives the camera to Auto again. docs/ARCHITECTURE.md §1–2.
// ============================================================================

string VERSION = "8.8.2";
string PASS    = "cinema-1.0-build1";
integer LITE   = 0;                // the free Take 12 Scenery build sets this to 1: only Scenic, the rest dim

integer UI_STATE    = 7320;
integer CFG_CHANGED = 7330;
integer OPTS        = 7340;        // shot -> here  "<shot>|<words, comma>|<states, comma>"
integer OPT         = 7341;        // here -> shots "<shot>|<word>"
integer LINKST      = 7342;        // sync -> here  "<alone/on/shared/theirs/dim>|<count>|<name>"
integer STRIP       = 7343;        // ui -> here
integer NOTE        = 7344;
integer TIP         = 7345;
integer SHAPE       = 7348;        // bars -> here  "<label>|<on/off/dim>"
integer MSG_VER     = 7360;
integer STATUS      = 7370;
integer CMD         = 7371;

// <CELLS> (generated by tools/art/make_strip.py: do not edit)
// WORDS: ~name|x|y|width px~ (cells 512 x 48 on take12_words); MARKS: ~name|x|y|w|h|content width~
string WORDS = "~TRACKING|0|0|160~PORTRAIT|512|0|155~FIXED|0|48|96~SCENIC|512|48|119~CLOSE|0|96|106~MEDIUM|512|96|129~WIDE|0|144|87~ME|512|144|55~US|0|192|52~SHOULDER|512|192|164~FILM|0|240|80~CLASSIC|512|240|136~L|0|288|30~R|512|288|32~VIEW A|0|336|116~VIEW B|512|336|114~KEEP NEW|0|384|159~FORGET SEAT|512|384|208~UNDO|0|432|95~LET GO|512|432|115~TAKE BACK|0|480|175~DRIFT|512|480|96~NEAR|0|528|89~ROOM|512|528|98~FAR|0|576|68~";
string MARKS = "~halo|576|64|256|64|256~sep|832|32|32|64|32~shape1.66|0|512|256|48|116~shape1.85|256|512|256|48|116~shape2.00|512|512|256|48|122~shape2.39|768|512|256|48|121~shapeFULL|0|560|256|48|126~shapeDIM|256|560|256|48|50~linkALONE|0|608|256|48|57~link1|256|608|256|48|81~link2|512|608|256|48|86~link3|768|608|256|48|86~link4|0|656|256|48|87~link5|256|656|256|48|86~link6|512|656|256|48|86~link7|768|656|256|48|85~link8|0|704|256|48|86~link9|256|704|256|48|86~linkSHARING|512|704|256|48|196~linkTHEIR FILM|768|704|256|48|228~shape3:2|0|752|256|48|104~shape4:3|256|752|256|48|105~shape1:1|512|752|256|48|95~shape4:5|768|752|256|48|105~shut|0|800|64|48|64~shutON|64|800|64|48|64~auto|128|800|64|48|64~autoON|192|800|64|48|64~";
// </CELLS>

list    SHOTS  = ["TRACKING", "PORTRAIT", "FIXED", "SCENIC"];
list    SIZES  = [0.8, 1.0, 1.25];                  // S, M, L
vector  WHITE  = <1.0, 1.0, 1.0>;
float   PADX   = 8.0;                               // px of air in a word cell, each side (make_strip.py PAD)

key     gOwner;
string  gTW = TEXTURE_BLANK;       // the textures
string  gTM = TEXTURE_BLANK;
integer gBox;                      // the parts' links
integer gHalo;
integer gShut;                      // the shutter (8.1.0), at the right end
integer gAutoP;                     // the Orbit (8.3.0), at the left end
integer gAuto;                      // ... lit: Auto directs
integer gSep;
integer gShp;
integer gLnk;
list    gSL;                       // shot words
list    gOL;                       // option words
list    gUL;                       // underlines
integer gFound;

float   gA = 1.778;                // the window
integer gSY = 1;                   // HUD +Y is left (/12 flip for a viewer that differs)
float   gS = 1.0;                  // size
integer gOpen;
integer gFade = 3;                 // fade step (3: done)
string  gState = "wait";           // core: wait / film / held / letgo / off / watch
string  gShot;                     // the running shot ("" waiting)
string  gHint;                     // a shot glowing once (a hint)
float   gHintT;
string  gOptShot;
list    gOpts;                     // the running shot's words ("/" a divider)
list    gOptSt;                    // ... their states
list    gOptVis;                   // the word on each option part, as laid out
string  gShapeL = "DIM";
string  gLinkSt = "alone";
string  gLinkN = "0";
float   gEye = -9.0;               // the eye-line guide (screen z), -9 hidden
integer gClear;                    // Look › Keys: Clear
list    gP;                        // the batch being built (put / go)
integer gHoldL;                    // the lit shot held down (its link; -1 done)
float   gHoldT;
float   gDrain;                    // ... its underline drains as you hold (0-1)

// ============================================================================
string cfg(string k)
{
    return llLinksetDataReadProtected("cin." + k, PASS);
}

float px(float v)
{
    return v * gS / 1080.0;
}

find()
{
    gSL = [0, 0, 0, 0];
    gOL = [0, 0, 0, 0, 0, 0];
    gUL = [0, 0, 0];
    gBox = 0; gHalo = 0; gSep = 0; gShp = 0; gLnk = 0; gShut = 0; gAutoP = 0;
    integer i;
    for (i = 2; i <= llGetNumberOfPrims(); i++)
    {
        string n = llGetLinkName(i);
        string h = llGetSubString(n, 0, 4);
        integer k = (integer)llGetSubString(n, 5, -1);
        if (n == "t12 box") gBox = i;
        else if (n == "t12 halo") gHalo = i;
        else if (n == "t12 sep") gSep = i;
        else if (n == "t12 shape") gShp = i;
        else if (n == "t12 link") gLnk = i;
        else if (n == "t12 shut") gShut = i;
        else if (n == "t12 auto") gAutoP = i;
        else if (h == "t12 s" && k < 4) gSL = llListReplaceList(gSL, [i], k, k);
        else if (h == "t12 o" && k < 6) gOL = llListReplaceList(gOL, [i], k, k);
        else if (h == "t12 u" && k < 3) gUL = llListReplaceList(gUL, [i], k, k);
    }
    gFound = (gBox && llList2Integer(gSL, 3));
}

// ---- textures ---------------------------------------------------------------------
string uuid(string tag)
{
    string k = cfg(tag);                                    // kept by screen (8.4.2), else the root's description
    if (k != "") return k;
    list D = llParseString2List(llList2String(llGetLinkPrimitiveParams(LINK_ROOT, [PRIM_DESC]), 0), [";"], []);
    integer i;
    for (i = 0; i < llGetListLength(D); i++)
    {
        list p = llParseString2List(llList2String(D, i), [" "], []);
        if (llList2String(p, 0) == tag) return llList2String(p, 1);
    }
    return TEXTURE_BLANK;                                   // (screen adopts a dropped texture and keeps its UUID: 8.4.2)
}


// ---- cells ---------------------------------------------------------------------------
// a cell from a table string "~name|a|b|…~": [a, b, …]
list cellOf(string T, string n)
{
    integer i = llSubStringIndex(T, "~" + n + "|");
    if (i < 0) return [];
    string r = llGetSubString(T, i + llStringLength(n) + 2, i + llStringLength(n) + 40);   // a cell, never the whole table
    return llParseString2List(llGetSubString(r, 0, llSubStringIndex(r, "~") - 1), ["|"], []);
}

// a word: [x, y, width px] on take12_words
list word(string w)
{
    list c = cellOf(WORDS, w);
    if (c == []) return [0, 0, 64];
    return c;
}

// a mark: [x, y, w, h, content width] on take12_marks
list mark(string m)
{
    list c = cellOf(MARKS, m);
    if (c == []) return [0, 0, 16, 16, 16];
    return c;
}

// PRIM_TEXTURE for a cell of w x h px at (x, y) on a 1024 sheet
list uv(string tex, float x, float y, float w, float h)
{
    return [PRIM_TEXTURE, ALL_SIDES, tex, <w / 1024.0, h / 1024.0, 0.0>, <(x + w * 0.5) / 1024.0 - 0.5, 0.5 - (y + h * 0.5) / 1024.0, 0.0>, 0.0];
}

list uvMark(string m)
{
    list c = mark(m);
    return uv(gTM, llList2Float(c, 0), llList2Float(c, 1), llList2Float(c, 4), llList2Float(c, 3));
}

// ---- placing ---------------------------------------------------------------------------
// a part at screen x, z (from the [12]) with depth d, size w x h, and its look
list at(integer link, float x, float z, float d, float w, float h)
{
    if (w < 0.01) w = 0.01;
    if (h < 0.01) h = 0.01;
    return [PRIM_LINK_TARGET, link, PRIM_POS_LOCAL, <d, -x * gSY, z>, PRIM_ROT_LOCAL, ZERO_ROTATION, PRIM_SIZE, <0.01, w, h>];
}

// a thin white line (an underline, under a lit word): a blank face cut down to ~2 px with PRIM_SLICE (a box slices
// along its Z, up on the screen). 8.0.4: a textured 0.01 m part showed a grey block over the word's lower half
list line(integer link, float x, float z, float w, float a)
{
    if (!link) return [];
    float s = px(1.0) / 0.01;
    return at(link, x, z, 0.001, w, 0.01) + [PRIM_TEXTURE, ALL_SIDES, TEXTURE_BLANK, <1.0, 1.0, 0.0>, ZERO_VECTOR, 0.0,
        PRIM_SLICE, <0.5 - s, 0.5 + s, 0.0>, PRIM_COLOR, ALL_SIDES, WHITE, a, PRIM_FULLBRIGHT, ALL_SIDES, TRUE, PRIM_GLOW, ALL_SIDES, 0.0];
}

list away(integer link)
{
    if (!link) return [];
    return [PRIM_LINK_TARGET, link, PRIM_POS_LOCAL, <0.02, 0.0, 0.0>, PRIM_SIZE, <0.01, 0.01, 0.01>, PRIM_COLOR, ALL_SIDES, WHITE, 0.0,
        PRIM_GLOW, ALL_SIDES, 0.0];
}

// ---- the look of each word ----------------------------------------------------------------
// alpha for a plain word, by state
float alphaOf(string st)
{
    if (st == "lit" || st == "accent" || st == "glow") return 1.0;
    if (st == "dim") return 0.22;
    return 0.51 + 0.24 * gClear;                        // Look › Keys: Soft (quiet words) or Clear (brighter)
}

// ============================================================================
// the strip goes out in small batches: 8.0.0 built one list of ~460 values for every part and died in-world with
// "Stack-Heap Collision" (a list and its copy while it grows); now no batch is much over 60 values
put(list L)
{
    gP += L;
    if (llGetListLength(gP) > 36) go();
}

go()
{
    if (gP != []) llSetLinkPrimitiveParamsFast(LINK_ROOT, gP);
    gP = [];
}

// a part placed, textured (tex: uv() or uvMark()), tinted and lit; through put()
show(integer link, float x, float z, float d, float w, float h, list tex, vector col, float a, float glow)
{
    put(at(link, x, z, d, w, h) + tex + [PRIM_COLOR, ALL_SIDES, col, a, PRIM_FULLBRIGHT, ALL_SIDES, TRUE, PRIM_GLOW, ALL_SIDES, glow]);
}

// a word's width on screen (its cell's content, px of 48)
float wordW(string w, float hw)
{
    return llList2Float(word(w), 2) / 48.0 * hw;
}

// everything on screen
layout()
{
    if (!gFound || !llGetAttached()) return;
    float f = gFade / 3.0;
    if (!gOpen) f = 0.0;
    integer i;
    // closed: the strip shrinks away
    if (f <= 0.0)
    {
        list L = [gBox, gHalo, gSep, gShp, gLnk, gShut, gAutoP] + gSL + gOL + llList2List(gUL, 0, 1 + (gEye <= -9.0));
        for (i = 0; i < llGetListLength(L); i++) put(away(llList2Integer(L, i)));
        gOptVis = [];
        go();
        return;
    }
    float hw = px(26.0);                                        // a word part's height (the 48 px cell): 12.5 px words
    float gap = px(22.0);
    float mid = px(36.0);                                       // from the [12]'s middle to the frame key and to Connect
    // (the band: screen's, 8.5.2)
    float aw = 0.0;
    if (gAutoP) aw = llList2Float(mark("auto"), 4) / 48.0 * hw;
    integer auto = (gAuto && gAutoP);
    float shw = 0.0;
    if (gShut) shw = llList2Float(mark("shut"), 4) / 48.0 * hw;
    list vis = gOpts;
    if (gOptShot != gShot || auto) vis = [];
    string lk = "ALONE";
    float la = 0.43;
    if (gLinkSt == "on") { lk = gLinkN; la = 0.92; }
    else if (gLinkSt == "shared") { lk = "SHARING"; la = 1.0; }
    else if (gLinkSt == "theirs") { lk = "THEIR FILM"; la = 1.0; }
    else if (gLinkSt == "dim") la = 0.22;
    else if ((integer)gLinkN > 0) lk = gLinkN;              // alone: the Take 12s near you, quietly (8.2.0)
    if ((integer)lk > 9) lk = "9";
    float lc = llList2Float(mark("link" + lk), 4);
    float lw = lc / 48.0 * hw;
    float sw = llList2Float(mark("shape" + gShapeL), 4) / 48.0 * hw;
    // 8.4.4's places again (8.5.6; 8.5.0-8.5.5 moved them four times, each worse): the words in a centred 16:9 area;
    // the shots from its left, 200 px in; the shutter and the options ending 200 px from its right; the frame key left
    // of the [12], Connect right of it. Each half is kept for its widest (FULL and the shots; THEIR FILM, the widest
    // options and the shutter), so nothing moves but the options. A narrow window: the insets give way, then
    // everything a touch smaller, the same in every shot
    float Wc = gA;
    if (Wc > 1.778) Wc = 1.778;
    float FW = llList2Float(mark("shapeFULL"), 4) / 48.0 * hw;
    float need = FW + aw + gap * (aw > 0.0);
    for (i = 0; i < 4; i++) need += wordW(llList2String(SHOTS, i), hw) + gap;
    float optsW = llList2Float(mark("linkTHEIR FILM"), 4) / 48.0 * hw + px(400.0) + shw + gap;
    if (optsW > need) need = optsW;
    float inset = 200.0 / 1080.0;                               // clear of the viewer's notices (8.4.4: 180 px)
    float q = (Wc * 0.5 - mid - 0.02) / (need + gap);           // the words keep their size while they fit at all
    if (q > 1.0) q = 1.0;
    hw *= q; gap *= q; aw *= q; shw *= q; lw *= q; sw *= q; FW *= q; need *= q;
    if (Wc * 0.5 - mid - gap - need < inset) inset = Wc * 0.5 - mid - gap - need;
    float spL = gap;
    float spR = gap;
    // the shots, from the left: the running one bright and underlined (8.0.4: no longer ink on a white box, which read
    // as a black smudge in-world); the hint: an outline round one (FIXED sat down, PORTRAIT stopped)
    float x = -Wc * 0.5 + inset;
    integer litBox;
    integer halo;
    // Auto's Orbit first: lit while Auto directs, quiet when the camera is yours
    if (gAutoP)
    {
        string ac = "auto";
        float aa = alphaOf("");
        if (gAuto) { ac = "autoON"; aa = 1.0 - 0.7 * gDrain * (gHoldL == gAutoP); }   // held down: it fades out
        if (gState == "watch") aa = 0.27;
        if (LITE) aa = 0.22;                                // the free Scenery: in the full Take 12
        show(gAutoP, x + aw * 0.5, 0.0, 0.001, aw, hw, uvMark(ac), WHITE, aa * f, 0.0);
        x += aw + spL;
    }
    for (i = 0; i < 4; i++)
    {
        string w = llList2String(SHOTS, i);
        list c = word(w);
        if (auto && llToLower(w) != gShot) put(away(llList2Integer(gSL, i)));   // Auto: only the shot it chose, next to the Orbit (8.5.9)
        else
        {
            float wd = llList2Float(c, 2) / 48.0 * hw;
            float tw = (llList2Float(c, 2) - 2.0 * PADX) / 48.0 * hw;
            float cx = x + wd * 0.5;
            string st = "";
            if (llToLower(w) == gShot && gShot != "") st = "lit";
            if (LITE && i < 3) st = "dim";
            if (auto) st = "auto";                              // the shot Auto chose: faint, nothing to choose
            float a = alphaOf(st);
            if (auto) a = 0.36;
            if (st == "lit")
            {
                float la = 0.94;
                if (gState != "film" && gState != "wait") { a = 0.6; la = 0.35; }   // you hold the camera, let go, watching: dimmed
                put(line(gBox, cx, -px(11.5), tw * (1.0 - gDrain), la * f));      // the box part is the shot's underline
                litBox = TRUE;
            }
            else if (llToLower(w) == gHint && gHalo)
            {
                show(gHalo, cx, 0.0, 0.002, tw + px(16.0), px(22.0), uvMark("halo"), WHITE, 0.8 * f, 0.0);
                halo = TRUE;
                a = 1.0;
            }
            if (gState == "watch" && st != "lit") a = 0.27;
            show(llList2Integer(gSL, i), cx, 0.0, 0.001, wd, hw, uv(gTW, llList2Float(c, 0), llList2Float(c, 1), llList2Float(c, 2), 48.0), WHITE, a * f, 0.0);
            x += wd + spL;
        }
    }
    if (!litBox) put(away(gBox));
    // the middle: the frame key left of the [12] (its mark where FULL's starts), Connect right of it
    float ssa = 0.86;
    if (gShapeL == "DIM") ssa = 0.27;
    show(gShp, -mid - FW + sw * 0.5, 0.0, 0.001, sw, hw, uvMark("shape" + gShapeL), WHITE, ssa * f, 0.0);
    show(gLnk, mid + lw * 0.5, 0.0, 0.001, lw, hw, uvMark("link" + lk), WHITE, la * f, 0.0);   // no glow: it blurs the word
    // from the right: the shutter (the right hand's key, as on a camera, 8.1.0; lit while open, the moment held; dim
    // with your own camera, nothing to hold), then the options before it
    x = Wc * 0.5 - inset;
    if (shw > 0.0)
    {
        float sa = 0.8;
        string sc = "shut";
        if (gState == "photo") { sc = "shutON"; sa = 1.0; }
        else if (gState != "film" && gState != "held") sa = 0.22;
        show(gShut, x - shw * 0.5, 0.0, 0.001, shw, hw, uvMark(sc), WHITE, sa * f, 0.0);
        x -= shw + gap;
    }
    integer part = 0;
    integer u = 0;
    integer sep;
    gOptVis = [];
    for (i = llGetListLength(vis) - 1; i >= 0; i--)
    {
        string w = llList2String(vis, i);
        if (w == "/")
        {
            if (gSep) show(gSep, x - px(8.0), 0.0, 0.001, 0.01, px(16.0), uvMark("sep"), WHITE, 0.4 * f, 0.0);
            sep = TRUE;
            x -= px(16.0) + spR;
        }
        else if (part < 6)
        {
            list c = word(w);
            float wd = llList2Float(c, 2) / 48.0 * hw;
            float tw = (llList2Float(c, 2) - 2.0 * PADX) / 48.0 * hw;
            float cx = x - wd * 0.5;
            string st = llList2String(gOptSt, i);
            float a = alphaOf(st);
            if (gState == "watch") a = 0.27;
            show(llList2Integer(gOL, part), cx, 0.0, 0.001, wd, hw, uv(gTW, llList2Float(c, 0), llList2Float(c, 1), llList2Float(c, 2), 48.0), WHITE, a * f, 0.0);
            if (st == "lit" && u < 2 && gState != "watch")
            {
                put(line(llList2Integer(gUL, u), cx, -px(11.5), tw, 0.94 * f));
                u++;
            }
            if (st == "accent" && gHalo)
            {
                show(gHalo, cx, 0.0, 0.002, tw + px(16.0), px(22.0), uvMark("halo"), WHITE, 0.86 * f, 0.0);
                halo = TRUE;
            }
            gOptVis += [w];                                  // the word on part k (right to left)
            part++;
            x -= wd + spR;
        }
    }
    if (!halo) put(away(gHalo));
    if (!sep) put(away(gSep));
    for (i = part; i < 6; i++) put(away(llList2Integer(gOL, i)));
    for (i = u; i < 3; i++) if (!(i == 2 && gEye > -9.0)) put(away(llList2Integer(gUL, i)));
    go();
}

load()
{
    gClear = (cfg("keys") == "clear");
    integer s = llListFindList(["s", "m", "l"], [cfg("size")]);
    if (s < 0) s = 1;
    gS = llList2Float(SIZES, s);
    gSY = 1;
    if (cfg("flip") == "1") gSY = -1;
    gTW = uuid("take12_words");
    gTM = uuid("take12_marks");
}

touched(integer link)
{
    string n = llGetLinkName(link);
    string h = llGetSubString(n, 0, 4);
    integer k = (integer)llGetSubString(n, 5, -1);
    if (llStringLength(n) > 6) h = "";                  // "t12 shape", "t12 sep" are not "t12 s0" (8.0.9: ▭ started Tracking)
    if (h == "t12 s" && k < 4)
    {
        string w = llList2String(SHOTS, k);
        if (LITE && k < 3) { llMessageLinked(LINK_SET, NOTE, "full", ""); return; }
        if (gAuto) { llMessageLinked(LINK_SET, CMD, "auto|0", ""); return; }   // Auto's shot, tapped: yours from here
        llMessageLinked(LINK_SET, TIP, w, "");
        llMessageLinked(LINK_SET, CMD, "shot|" + llToLower(w), "");
    }
    else if (h == "t12 o" && k < llGetListLength(gOptVis))
    {
        string w = llList2String(gOptVis, k);
        llMessageLinked(LINK_SET, TIP, w, "");
        llMessageLinked(LINK_SET, OPT, gShot + "|" + w, "");
    }
    else if (n == "t12 shape")
    {
        llMessageLinked(LINK_SET, TIP, "shape", "");
        llMessageLinked(LINK_SET, CMD, "frames", "");                  // this shot's frame (ui's dialog, 8.0.9)
    }
    else if (n == "t12 shut")
    {
        if (gState != "film" && gState != "held" && gState != "photo") return;
        llMessageLinked(LINK_SET, TIP, "shutter", "");
        llMessageLinked(LINK_SET, CMD, "shutter", "");
    }
    else if (n == "t12 auto")
    {
        if (LITE) { llMessageLinked(LINK_SET, NOTE, "full", ""); return; }
        llMessageLinked(LINK_SET, TIP, "auto", "");
        llMessageLinked(LINK_SET, CMD, "auto|" + (string)(!gAuto), "");
    }
    else if (n == "t12 link")
    {
        if (LITE && gLinkSt == "dim") { llMessageLinked(LINK_SET, NOTE, "full", ""); return; }
        llMessageLinked(LINK_SET, TIP, "link", "");
        llMessageLinked(LINK_SET, CMD, "connect", "");
    }
}

tick()
{
    float t = 2.0;
    if (gFade < 3 && gOpen) t = 0.07;
    else if (gHoldL > 0) t = 0.1;
    else if (gHint != "") t = 1.0;
    llSetTimerEvent(t * (llGetAttached() != 0));
}

// ============================================================================
default
{
    state_entry()
    {
        gOwner = llGetOwner();
        find();
        load();
        llMessageLinked(LINK_SET, STRIP, "aspect?", "");        // the window: screen measures it (8.5.2)
        llMessageLinked(LINK_SET, MSG_VER, VERSION, "strip");
        layout();
        tick();
    }

    on_rez(integer p)
    {
        llResetScript();
    }

    attach(key id)
    {
        if (id == NULL_KEY) return;
        gOpen = FALSE;                                      // a clean start: closed, waiting
        gState = "wait";
        gShot = "";
        gHint = "";
        gEye = -9.0;
        gAuto = FALSE;                                      // Auto lights when tracking.lsl starts it
        layout();
        tick();
    }

    changed(integer c)
    {
        if (c & CHANGED_OWNER) llResetScript();
        if (c & CHANGED_LINK)
        {
            find();
            layout();
        }
        if (c & CHANGED_INVENTORY) llSetTimerEvent(1.0);   // screen adopts a dropped texture: read it again soon
    }

    touch_start(integer n)
    {
        if (llDetectedKey(0) != gOwner) return;
        integer link = llDetectedLinkNumber(0);
        if (link <= 1 || !gOpen) return;
        // the lit shot: a tap is its next view, a hold (0.8 s) hands the camera to your viewer (8.0.7); the lit Orbit
        // too: a hold ends Auto and the camera is your viewer's (8.4.5)
        integer k = llListFindList(gSL, [link]);
        if ((k >= 0 && llToLower(llList2String(SHOTS, k)) == gShot && (gState == "film" || gState == "held" || gState == "photo"))
            || (link == gAutoP && gAuto && !LITE && gState != "watch" && gState != "off"))
        {
            gHoldL = link;
            gHoldT = llGetTime();
            tick();
            return;
        }
        touched(link);
    }

    touch_end(integer n)
    {
        if (llDetectedKey(0) != gOwner || !gHoldL) return;
        if (gHoldL > 0) touched(gHoldL);                    // let go early: a tap
        gHoldL = 0;
        gDrain = 0.0;
        layout();
    }

    link_message(integer sender, integer num, string str, key id)
    {
        if (num == UI_STATE)
        {
            list L = llParseStringKeepNulls(str, ["|"], []);
            gState = llList2String(L, 0);
            gShot = llList2String(L, 1);
            string h = llList2String(L, 2);
            if (h != "")
            {
                if (h != gHint && !gAuto) llMessageLinked(LINK_SET, TIP, "hint" + h, "");   // what the outline means (8.0.6); Auto takes care
                gHint = h;
                gHintT = llGetTime();
            }
            if (gState == "off")
            {
                gOpen = FALSE;
                gHint = "";
            }
            layout();
            tick();
        }
        else if (num == OPTS)
        {
            list L = llParseStringKeepNulls(str, ["|"], []);
            gOptShot = llList2String(L, 0);
            gOpts = llParseStringKeepNulls(llList2String(L, 1), [","], []);
            gOptSt = llParseStringKeepNulls(llList2String(L, 2), [","], []);
            if (llList2String(L, 1) == "") gOpts = [];
            if (llListFindList(gOpts, ["LET GO"]) >= 0) llMessageLinked(LINK_SET, TIP, "seated", "");   // the seat's two words
            layout();
        }
        else if (num == LINKST)
        {
            list L = llParseStringKeepNulls(str, ["|"], []);
            gLinkSt = llList2String(L, 0);
            gLinkN = llList2String(L, 1);
            layout();
        }
        else if (num == SHAPE)
        {
            list L = llParseStringKeepNulls(str, ["|"], []);
            gShapeL = llList2String(L, 0);
            if (llList2String(L, 1) == "off") gShapeL = "FULL";
            if (llList2String(L, 1) == "dim") gShapeL = "DIM";
            layout();
        }
        else if (num == STRIP)
        {
            if (llGetSubString(str, 0, 4) == "note|" || str == "aspect?") return;   // screen's
            if (llGetSubString(str, 0, 6) == "aspect|") { gA = (float)llGetSubString(str, 7, -1); layout(); return; }
            list L = llParseStringKeepNulls(str, ["|"], []);
            string a = llList2String(L, 0);
            if (a == "toggle" || a == "open" || a == "close")
            {
                integer o = !gOpen;
                if (a == "open") o = TRUE;
                if (a == "close") o = FALSE;
                if (o && !gOpen) gFade = 1;
                gOpen = o;
                llLinksetDataWriteProtected("cin.open", (string)gOpen, PASS);   // worn again, as you left it (8.0.5)
            }
            else if (a == "eye")
            {
                gEye = -9.0;
                if (llList2String(L, 1) != "off") gEye = (float)llList2String(L, 1);
            }
            else if (a == "layout") load();
            layout();
            tick();
        }
        else if (num == CFG_CHANGED && (str == "place" || str == "size" || str == "flip" || str == "keys" || str == "all"))
        {
            load();
            layout();
        }
        else if (num == CMD && llGetSubString(str, 0, 4) == "auto|")
        {
            gAuto = (llGetSubString(str, 5, 5) == "1");
            layout();
        }
        else if (num == MSG_VER && str == "?") llMessageLinked(LINK_SET, MSG_VER, VERSION, "strip");
        else if (num == STATUS && str == "?")
            llOwnerSay("[Take 12/strip] v" + VERSION + " " + llList2String(["closed", "open"], gOpen) + ", window " + (string)gA
                + ", parts " + llList2String(["missing", "found"], gFound) + ", free mem " + (string)llGetFreeMemory());
    }

    timer()
    {
        if (gHoldL > 0)
        {
            gDrain = (llGetTime() - gHoldT) / 0.8;
            if (gDrain >= 1.0)
            {
                gHoldL = -1;                                // held: the camera is your viewer's, the strip stays
                gDrain = 0.0;
                llMessageLinked(LINK_SET, CMD, "stop", "");
                llMessageLinked(LINK_SET, NOTE, "released", "");
            }
            layout();
        }
        if (gFade < 3 && gOpen)
        {
            gFade++;
            layout();
        }
        if (gHint != "" && llGetTime() - gHintT > 5.0)
        {
            gHint = "";                                     // a hint glows once, for 5 s
            layout();
        }
        if (gTW == TEXTURE_BLANK || gTM == TEXTURE_BLANK)
        {
            load();                                         // the textures, once screen has adopted them
            if (gTW != TEXTURE_BLANK && gTM != TEXTURE_BLANK) layout();
        }
        tick();
    }
}
